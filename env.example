# SR Linux gRPC endpoint serving gnoi.containerz.
export CONTAINERZ_ADDRESS=192.0.2.10:57400

# gRPC honors HTTPS_PROXY; reach the router directly.
export NO_PROXY="${NO_PROXY:+$NO_PROXY,}192.0.2.10"
export no_proxy="${no_proxy:+$no_proxy,}192.0.2.10"

# TLS trust and optional server-name override.
export CONTAINERZ_CA="$PWD/certs/ca.pem"
export CONTAINERZ_SERVER_NAME=srl.example.net

# Optional mTLS identity.
# export CONTAINERZ_CERT="$PWD/certs/client.pem"
# export CONTAINERZ_KEY="$PWD/certs/client-key.pem"

# SR Linux AAA credentials. Keep the real password out of this file in git.
export CONTAINERZ_USERNAME=admin
export CONTAINERZ_PASSWORD='replace-me'
